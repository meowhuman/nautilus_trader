# Claude Code Hooks Environment Configuration
# Copy this file to .env and fill in your API keys

# ===== Project Configuration =====
PROJECT_NAME="your-project-name"
ENGINEER_NAME="Teriver"  # Used for personalized notifications

# ===== API Keys for Enhanced Features =====
# Leave empty to use offline alternatives

# OpenAI API (for GPT models and TTS)
OPENAI_API_KEY=""
OPENAI_ORG_ID=""

# Anthropic API (for Claude models)
ANTHROPIC_API_KEY=""

# ElevenLabs API (for premium TTS)
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID="gZL79pBTvaNfNPOCXh6n"  # Rachel = young, warm female voice

# Voice Tone Settings (mindful yogi style)
TTS_STABILITY="0.3"           # 0.0-1.0: Lower = more emotional variation (human-like)
TTS_STYLE="0.95"              # 0.0-1.0: Higher = more natural expression (warm, intimate)
TTS_SIMILARITY_BOOST="0.85"   # 0.0-1.0: Higher = closer to original voice
TTS_VOICE_SPEED="0.4"         # Slow, deliberate, mindful delivery

# ===== Logging Configuration =====
# Optional: Custom log directory
# CLAUDE_HOOKS_LOG_DIR="/path/to/custom/logs"

# ===== Event Forwarding =====
# Optional: External observability endpoint
# EVENT_ENDPOINT="http://localhost:4000/events"

# ===== Voice Preferences =====
# Optional: TTS provider preference
# TTS_PROVIDER="auto"  # auto, elevenlabs, openai, pyttsx3

# Optional: Voice settings
# TTS_VOICE_SPEED="1.0"  # 0.5 to 2.0
# TTS_VOICE_PITCH="1.0"  # 0.5 to 2.0